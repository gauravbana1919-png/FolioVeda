generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  projects      Project[]
  resumes       Resume[]
  portfolio     Portfolio?
  dailyAiCalls  Int       @default(0)
  lastAiCallAt  DateTime?
  consentGiven  Boolean   @default(false)
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  skills    String?
  location  String?
  phone     String?
  socials   String?  // JSON string
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoName    String
  title       String
  description String?
  techStack   String?
  imageUrl    String?
  githubUrl   String
  liveUrl     String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resume {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseData           String   // Original profile/experience
  tailoredData       String   // AI-tailored output
  targetJobDesc      String
  matchScore         Int?
  isConfirmed        Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String
  theme        String   @default("system") // light, dark, system
  customDomain String?
  designPrefs  String?    // Stores reference URL, specific info, custom colors/fonts
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
}
