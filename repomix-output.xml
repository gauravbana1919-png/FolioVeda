<file path="src/app/api/inspiration/generate/route.ts">
import { NextResponse } from "next/server";
import { getServerSession } from "next-auth/next";
import { authOptions } from "@/lib/auth";
import prisma from "@/lib/db";
import { InspirationGenerateInputSchema, StyleProfileSchema } from "@/types/inspiration";
import { generateThemeFromStyleProfile } from "@/lib/inspiration/theme-generator";
import { enforceSimilarityGuard } from "@/lib/inspiration/similarity-guard";

export async function POST(req: Request) {
  try {
    let session = null;
    try {
      session = await getServerSession(authOptions);
    } catch {
      // Test environment or unauthenticated scope
    }

    const body = await req.json();
    const parseResult = InspirationGenerateInputSchema.safeParse(body);
    if (!parseResult.success) {
      return NextResponse.json(
        { error: "Invalid generate parameters", details: parseResult.error.flatten() },
        { status: 400 }
      );
    }

    const { requestId, closeness } = parseResult.data;

    // Look up inspiration request
    const inspirationReq = await prisma.inspirationRequest.findUnique({
      where: { id: requestId },
    });

    if (!inspirationReq || !inspirationReq.styleProfile) {
      return NextResponse.json(
        { error: "Inspiration request not found or not yet analyzed." },
        { status: 404 }
      );
    }

    const rawProfile = JSON.parse(inspirationReq.styleProfile);
    const validProfile = StyleProfileSchema.parse(rawProfile);

    // Determine user ID
    let userId: string | null = inspirationReq.userId;
    if (!userId && session?.user?.email) {
      const u = await prisma.user.findUnique({
        where: { email: session.user.email },
        select: { id: true },
      });
      if (u) userId = u.id;
    }

    // Generate custom ThemePackage with modulated closeness
    const baseTheme = generateThemeFromStyleProfile(validProfile, closeness, userId);

    // Enforce Similarity Guard (guarantees originality under 0.78 threshold)
    const { theme: finalTheme, similarity } = enforceSimilarityGuard(validProfile, baseTheme);

    // Update InspirationRequest in DB
    await prisma.inspirationRequest.update({
      where: { id: requestId },
      data: {
        status: "generated",
        closeness,
        generatedTheme: JSON.stringify(finalTheme),
        similarityScore: similarity.overallScore,
        isFlagged: similarity.adjustmentApplied,
      },
    });

    return NextResponse.json({
      success: true,
      closeness,
      theme: finalTheme,
      similarity,
      notice: "Original theme package synthesized from abstract traits. Zero proprietary code or assets stored.",
    });
  } catch (error: any) {
    console.error("Inspiration Generate Error:", error);
    return NextResponse.json(
      { error: error.message || "Failed to generate theme from inspiration." },
      { status: 500 }
    );
  }
}
</file>

<file path="src/app/api/webhooks/github/route.ts">
import { NextResponse } from 'next/server';
import { Webhooks } from '@octokit/webhooks';
import crypto from 'crypto';
import prisma from '@/lib/db';

// Initialize the webhooks instance with the secret from environment
const webhooks = new Webhooks({
  secret: process.env.GITHUB_WEBHOOK_SECRET || 'test-secret',
});

// Mock function for auto-generating details from README
function extractDetailsFromReadme(readmeContent: string) {
  // In Stage 4, we will use an LLM here
  // For now, we return basic mock details
  return {
    description: "Auto-extracted description from README.",
    techStack: ["Next.js", "TypeScript"], // Basic mock
  };
}

export async function POST(req: Request) {
  try {
    const signature = req.headers.get('x-hub-signature-256');
    const event = req.headers.get('x-github-event');
    
    if (!signature || !event) {
      return NextResponse.json({ error: 'Missing headers' }, { status: 400 });
    }

    const payloadText = await req.text();
    
    // Verify webhook signature
    const verified = await webhooks.verify(payloadText, signature);
    if (!verified) {
      return NextResponse.json({ error: 'Invalid signature' }, { status: 401 });
    }

    const payload = JSON.parse(payloadText);

    // Only process pushes
    if (event === 'push') {
      const repoName = payload.repository.name;
      const topics = payload.repository.topics || [];
      const branch = payload.ref.replace('refs/heads/', '');
      const defaultBranch = payload.repository.default_branch;

      // Filter: ONLY if repo name starts with 'pf-' OR has topic 'portfolio'
      // Also only process pushes to the default branch
      if (
        (repoName.startsWith('pf-') || topics.includes('portfolio')) &&
        branch === defaultBranch
      ) {
        // Here we would use Octokit to fetch the README.md
        // const readme = await octokit.rest.repos.getReadme({ ... })
        // const decodedReadme = Buffer.from(readme.data.content, 'base64').toString()
        
        const details = extractDetailsFromReadme("# Mock Readme Content");
        
        // Find the user by their GitHub account ID
        const githubAccountId = String(payload.sender.id);
        
        const account = await prisma.account.findUnique({
          where: {
            provider_providerAccountId: {
              provider: 'github',
              providerAccountId: githubAccountId
            }
          }
        });

        if (account) {
          // Check if project exists, then update or create
          const existingProject = await prisma.project.findFirst({
            where: {
              userId: account.userId,
              repoName: repoName,
            }
          });

          if (existingProject) {
            await prisma.project.update({
              where: { id: existingProject.id },
              data: {
                description: details.description,
                techStack: details.techStack.join(','),
              }
            });
          } else {
            await prisma.project.create({
              data: {
                userId: account.userId,
                repoName: repoName,
                title: repoName.replace('pf-', '').replace(/-/g, ' '),
                description: details.description,
                techStack: details.techStack.join(','),
                githubUrl: payload.repository.html_url,
              }
            });
          }
        }
        
        return NextResponse.json({ 
          message: 'Project sync processed',
          project: { repoName, ...details }
        }, { status: 200 });
      } else {
        return NextResponse.json({ message: 'Ignored: Does not match portfolio criteria' }, { status: 200 });
      }
    }

    return NextResponse.json({ message: 'Event not handled' }, { status: 200 });

  } catch (error) {
    console.error('Webhook processing error:', error);
    return NextResponse.json({ error: 'Internal server error' }, { status: 500 });
  }
}
</file>

