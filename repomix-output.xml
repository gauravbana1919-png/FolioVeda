<file path="src/components/portfolio/AiAgentWidget.tsx">
"use client";

import React, { useState, useRef, useEffect } from "react";
import { MessageSquare, X, Send, Sparkles, Loader2, Bot, User, ChevronRight } from "lucide-react";

interface Message {
  id: string;
  sender: "user" | "bot";
  text: string;
  timestamp: Date;
}

interface AiAgentWidgetProps {
  portfolioContext?: any;
}

export function AiAgentWidget({ portfolioContext }: AiAgentWidgetProps) {
  const [isOpen, setIsOpen] = useState(false);
  const [messages, setMessages] = useState<Message[]>([
    {
      id: "welcome",
      sender: "bot",
      text: "👋 Hi! I'm **PortBot**, your AI assistant for FolioVeda.\n\nAsk me anything about choosing templates, auto-importing GitHub repositories, uploading your LinkedIn PDF, or 1-click GitHub Pages deployment!",
      timestamp: new Date(),
    },
  ]);
  const [input, setInput] = useState("");
  const [isTyping, setIsTyping] = useState(false);
  const chatEndRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    if (isOpen) {
      chatEndRef.current?.scrollIntoView({ behavior: "smooth" });
    }
  }, [messages, isOpen, isTyping]);

  const handleSend = async (textToSend?: string) => {
    const query = (textToSend || input).trim();
    if (!query) return;

    const userMsg: Message = {
      id: `user-${Date.now()}`,
      sender: "user",
      text: query,
      timestamp: new Date(),
    };

    setMessages((prev) => [...prev, userMsg]);
    if (!textToSend) setInput("");
    setIsTyping(true);

    try {
      const res = await fetch("/api/ai/assistant", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          query,
          portfolioContext,
        }),
      });

      const data = await res.json();
      const botReply =
        data.reply ||
        "I'm here to help you build and publish your dream portfolio. Feel free to ask about templates, GitHub sync, or deployment!";

      setMessages((prev) => [
        ...prev,
        {
          id: `bot-${Date.now()}`,
          sender: "bot",
          text: botReply,
          timestamp: new Date(),
        },
      ]);
    } catch (err) {
      setMessages((prev) => [
        ...prev,
        {
          id: `bot-${Date.now()}`,
          sender: "bot",
          text: "I encountered an error connecting to the AI brain. Please try asking again!",
          timestamp: new Date(),
        },
      ]);
    } finally {
      setIsTyping(false);
    }
  };

  const quickPrompts = [
    "🚀 How to deploy to GitHub Pages?",
    "🎨 Help me pick a template",
    "🔄 How to auto-import GitHub repos?",
    "📄 How to upload LinkedIn PDF?",
    "📦 How to download ZIP or HTML?",
  ];

  return (
    <div className="fixed bottom-6 right-6 z-50 font-sans">
      {/* Floating Toggle Button */}
      {!isOpen && (
        <button
          onClick={() => setIsOpen(true)}
          className="group relative flex items-center gap-2.5 px-4 py-3 bg-gradient-to-r from-cyan-600 via-teal-500 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white font-semibold rounded-full shadow-[0_0_30px_rgba(6,182,212,0.4)] border border-cyan-400/30 transition-all transform hover:scale-105 active:scale-95"
          aria-label="Open AI Portfolio Assistant"
        >
          <span className="relative flex h-3 w-3">
            <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-300 opacity-75"></span>
            <span className="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
          </span>
          <Bot className="w-5 h-5" />
          <span className="text-sm font-medium tracking-wide">AI Assistant</span>
        </button>
      )}

      {/* Chat Window */}
      {isOpen && (
        <div className="bg-slate-950/95 backdrop-blur-xl border border-slate-800 rounded-2xl shadow-2xl w-[90vw] max-w-[420px] h-[580px] flex flex-col overflow-hidden animate-in fade-in slide-in-from-bottom-6 duration-200">
          {/* Header */}
          <div className="px-5 py-4 border-b border-slate-800 bg-slate-900/60 flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-cyan-500/20">
                <Sparkles className="w-5 h-5" />
              </div>
              <div>
                <h3 className="text-sm font-bold text-white flex items-center gap-1.5">
                  PortBot AI
                  <span className="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Online
                  </span>
                </h3>
                <p className="text-xs text-slate-400">FolioVeda Assistant</p>
              </div>
            </div>
            <button
              onClick={() => setIsOpen(false)}
              className="p-1.5 text-slate-400 hover:text-white hover:bg-slate-800/60 rounded-lg transition-colors"
              aria-label="Close Assistant"
            >
              <X className="w-5 h-5" />
            </button>
          </div>

          {/* Messages Body */}
          <div className="flex-1 p-4 overflow-y-auto space-y-4 custom-scrollbar text-sm">
            {messages.map((msg) => (
              <div
                key={msg.id}
                className={`flex gap-2.5 ${
                  msg.sender === "user" ? "justify-end" : "justify-start"
                }`}
              >
                {msg.sender === "bot" && (
                  <div className="w-7 h-7 rounded-full bg-cyan-950 border border-cyan-800 text-cyan-400 flex items-center justify-center shrink-0 mt-0.5">
                    <Bot className="w-4 h-4" />
                  </div>
                )}
                <div
                  className={`max-w-[85%] rounded-2xl px-4 py-3 leading-relaxed whitespace-pre-wrap ${
                    msg.sender === "user"
                      ? "bg-cyan-600 text-white rounded-br-sm"
                      : "bg-slate-900/90 text-slate-200 border border-slate-800/80 rounded-bl-sm"
                  }`}
                >
                  {msg.text}
                </div>
                {msg.sender === "user" && (
                  <div className="w-7 h-7 rounded-full bg-slate-800 text-slate-300 flex items-center justify-center shrink-0 mt-0.5">
                    <User className="w-4 h-4" />
                  </div>
                )}
              </div>
            ))}

            {isTyping && (
              <div className="flex gap-2.5 items-center text-slate-400 text-xs">
                <div className="w-7 h-7 rounded-full bg-cyan-950 border border-cyan-800 text-cyan-400 flex items-center justify-center shrink-0">
                  <Bot className="w-4 h-4" />
                </div>
                <div className="bg-slate-900 px-3 py-2 rounded-xl border border-slate-800 flex items-center gap-1.5">
                  <span className="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                  <span className="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse delay-150"></span>
                  <span className="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse delay-300"></span>
                  <span className="ml-1 text-[11px]">Thinking...</span>
                </div>
              </div>
            )}
            <div ref={chatEndRef} />
          </div>

          {/* Quick Prompts Strip */}
          <div className="px-3 py-2 border-t border-slate-900 bg-slate-950/70 overflow-x-auto custom-scrollbar flex gap-1.5">
            {quickPrompts.map((prompt, idx) => (
              <button
                key={idx}
                onClick={() => handleSend(prompt)}
                disabled={isTyping}
                className="whitespace-nowrap text-[11px] px-2.5 py-1 rounded-full bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-cyan-300 border border-slate-800 transition-colors shrink-0 disabled:opacity-50"
              >
                {prompt}
              </button>
            ))}
          </div>

          {/* Input Bar */}
          <form
            onSubmit={(e) => {
              e.preventDefault();
              handleSend();
            }}
            className="p-3 border-t border-slate-800 bg-slate-900/50 flex items-center gap-2"
          >
            <input
              type="text"
              value={input}
              onChange={(e) => setInput(e.target.value)}
              placeholder="Ask anything about your portfolio..."
              disabled={isTyping}
              className="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500 disabled:opacity-50"
            />
            <button
              type="submit"
              disabled={isTyping || !input.trim()}
              className="p-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 disabled:bg-slate-800 text-white disabled:text-slate-600 transition-colors flex items-center justify-center shrink-0"
            >
              {isTyping ? <Loader2 className="w-4 h-4 animate-spin" /> : <Send className="w-4 h-4" />}
            </button>
          </form>
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/portfolio/DeployModal.tsx">
"use client";

import React, { useState } from "react";
import { Rocket, X, ExternalLink, Terminal, ShieldAlert, CheckCircle2, Copy, Check, Loader2 } from "lucide-react";
import { ThemePackage } from "@/types/theme";
import { PortfolioContent } from "@/types/content";
import { getStandaloneHtml } from "@/lib/export/exportPortfolio";

interface DeployModalProps {
  isOpen: boolean;
  onClose: () => void;
  theme: ThemePackage;
  content: PortfolioContent;
}

export function DeployModal({ isOpen, onClose, theme, content }: DeployModalProps) {
  const [repoName, setRepoName] = useState("my-portfolio");
  const [pat, setPat] = useState("");
  const [logs, setLogs] = useState<string[]>([]);
  const [status, setStatus] = useState<"idle" | "deploying" | "success" | "error">("idle");
  const [liveUrl, setLiveUrl] = useState("");
  const [copied, setCopied] = useState(false);

  if (!isOpen) return null;

  const logMessage = (msg: string) => {
    setLogs((prev) => [...prev, `> ${msg}`]);
  };

  const handleDeploy = async () => {
    if (!pat.trim() || !repoName.trim()) {
      alert("Please provide both a Repository Name and your GitHub Personal Access Token (PAT).");
      return;
    }

    setLogs([]);
    setStatus("deploying");

    try {
      logMessage("Generating standalone production portfolio bundle...");
      const htmlString = getStandaloneHtml(theme, content);

      logMessage("Sending deployment payload to FolioVeda deployment pipeline...");
      const res = await fetch("/api/github/deploy", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          pat: pat.trim(),
          repoName: repoName.trim(),
          htmlString,
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || "Deployment failed.");
      }

      logMessage(`Repository: ${data.repoUrl}`);
      logMessage(`Committed index.html to branch "${data.branch}".`);
      logMessage(`GitHub Pages triggered.`);
      logMessage(`Live URL configured: ${data.liveUrl}`);

      setLiveUrl(data.liveUrl);
      setStatus("success");
    } catch (err: any) {
      logMessage(`[ERROR] ${err.message}`);
      setStatus("error");
    }
  };

  const handleCopyUrl = () => {
    if (!liveUrl) return;
    navigator.clipboard.writeText(liveUrl);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md animate-in fade-in duration-150">
      <div className="bg-slate-900 border border-slate-700 w-full max-w-2xl rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
        {/* Header */}
        <div className="flex items-center justify-between p-5 border-b border-slate-800 bg-slate-950/70">
          <div className="flex items-center gap-3">
            <div className="p-2 bg-gradient-to-br from-cyan-500 to-indigo-600 rounded-xl shadow-lg shadow-cyan-500/20">
              <Rocket className="w-5 h-5 text-white" />
            </div>
            <div>
              <h2 className="text-lg font-bold text-white">Deploy to GitHub Pages</h2>
              <p className="text-xs text-slate-400">1-Click instant hosting on username.github.io</p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Content */}
        <div className="p-6 overflow-y-auto space-y-6 custom-scrollbar text-sm text-slate-200">
          {status !== "success" ? (
            <div className="space-y-4">
              <div>
                <label className="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                  Repository Name
                </label>
                <input
                  type="text"
                  value={repoName}
                  onChange={(e) => setRepoName(e.target.value)}
                  placeholder="e.g. portfolio or my-developer-site"
                  disabled={status === "deploying"}
                  className="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-cyan-500 disabled:opacity-50"
                />
              </div>

              <div>
                <div className="flex justify-between items-center mb-1.5">
                  <label className="text-xs font-semibold text-slate-300 uppercase tracking-wider">
                    Personal Access Token (PAT)
                  </label>
                  <a
                    href="https://github.com/settings/tokens/new?scopes=repo,workflow&description=FolioVeda+Pages+Deployer"
                    target="_blank"
                    rel="noreferrer"
                    className="text-xs text-cyan-400 hover:text-cyan-300 flex items-center gap-1 font-medium"
                  >
                    Generate Token on GitHub <ExternalLink className="w-3 h-3" />
                  </a>
                </div>
                <input
                  type="password"
                  value={pat}
                  onChange={(e) => setPat(e.target.value)}
                  placeholder="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                  disabled={status === "deploying"}
                  className="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-white font-mono text-xs focus:outline-none focus:border-cyan-500 disabled:opacity-50"
                />
                <div className="flex items-start gap-2 pt-2 text-xs text-slate-400">
                  <ShieldAlert className="w-4 h-4 text-amber-400 shrink-0 mt-0.5" />
                  <p>
                    Your token is used strictly in-memory to execute the GitHub API deployment request. It is never stored in any database.
                  </p>
                </div>
              </div>

              <button
                onClick={handleDeploy}
                disabled={status === "deploying" || !pat.trim() || !repoName.trim()}
                className="w-full py-3 px-4 bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 disabled:opacity-50 text-white font-bold rounded-xl transition-all shadow-lg shadow-cyan-600/25 flex justify-center items-center gap-2"
              >
                {status === "deploying" ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" /> Deploying to GitHub...
                  </>
                ) : (
                  <>
                    <Rocket className="w-4 h-4" /> Build &amp; Deploy Now
                  </>
                )}
              </button>
            </div>
          ) : (
            <div className="p-5 bg-emerald-950/40 border border-emerald-500/30 rounded-2xl space-y-4 text-center">
              <div className="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto">
                <CheckCircle2 className="w-7 h-7" />
              </div>
              <div>
                <h3 className="text-lg font-bold text-white">Portfolio Successfully Deployed!</h3>
                <p className="text-xs text-slate-400 mt-1">
                  GitHub Pages is building your site. It will be live globally in ~1 minute.
                </p>
              </div>

              <div className="flex items-center justify-between bg-slate-950 border border-slate-800 rounded-xl p-3 text-left">
                <span className="font-mono text-xs text-cyan-300 truncate max-w-[340px]">
                  {liveUrl}
                </span>
                <div className="flex gap-2">
                  <button
                    onClick={handleCopyUrl}
                    className="p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg flex items-center gap-1 text-xs"
                  >
                    {copied ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                  </button>
                  <a
                    href={liveUrl}
                    target="_blank"
                    rel="noreferrer"
                    className="p-1.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-lg flex items-center gap-1 text-xs font-semibold px-2.5"
                  >
                    Visit <ExternalLink className="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>
            </div>
          )}

          {/* Terminal Logs */}
          {logs.length > 0 && (
            <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 font-mono text-xs text-slate-300 space-y-1 max-h-48 overflow-y-auto custom-scrollbar">
              <div className="flex items-center gap-2 text-slate-500 pb-2 border-b border-slate-900 mb-2 font-bold uppercase text-[10px]">
                <Terminal className="w-3.5 h-3.5" /> Deployment Console
              </div>
              {logs.map((log, index) => (
                <div
                  key={index}
                  className={`${
                    log.includes("[ERROR]")
                      ? "text-rose-400 font-semibold"
                      : log.includes("Live URL")
                      ? "text-emerald-400 font-semibold"
                      : "text-slate-300"
                  }`}
                >
                  {log}
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/portfolio/GithubImporter.tsx">
"use client";

import React, { useState } from "react";
import { DownloadCloud, Loader2, CheckCircle2, AlertCircle } from "lucide-react";
import { PortfolioContent } from "@/types/content";

interface GithubImporterProps {
  onImportSuccess: (importedData: {
    profile?: {
      name?: string | null;
      username?: string | null;
      avatarUrl?: string | null;
      bio?: string | null;
      location?: string | null;
      github?: string | null;
      email?: string | null;
    };
    projects?: any[];
    skills?: string[];
  }) => void;
}

export function GithubImporter({ onImportSuccess }: GithubImporterProps) {
  const [username, setUsername] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [successCount, setSuccessCount] = useState<number | null>(null);

  const handleImport = async () => {
    if (!username.trim()) return;

    setLoading(true);
    setError(null);
    setSuccessCount(null);

    try {
      const res = await fetch("/api/github/import", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username: username.trim() }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || "Failed to import from GitHub.");
      }

      onImportSuccess({
        profile: data.profile,
        projects: data.projects,
        skills: data.skills,
      });

      setSuccessCount(data.projects?.length || 0);
      setUsername("");
    } catch (err: any) {
      setError(err.message || "An error occurred during import.");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="bg-slate-900/60 border border-slate-800 rounded-2xl p-5 mb-6 text-sm">
      <div className="flex items-center gap-3 mb-2">
        <div className="p-2 bg-slate-800 rounded-xl text-white">
          <DownloadCloud className="w-5 h-5 text-cyan-400" />
        </div>
        <div>
          <h3 className="font-semibold text-white">Auto-Import from GitHub</h3>
          <p className="text-xs text-slate-400">
            Automatically populate your profile, top public repositories, star counts, and tech skills.
          </p>
        </div>
      </div>

      <div className="flex flex-col sm:flex-row gap-3 mt-4">
        <input
          type="text"
          value={username}
          onChange={(e) => setUsername(e.target.value)}
          placeholder="GitHub Username (e.g. gauravbana1919-png)"
          className="flex-1 bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm"
          onKeyDown={(e) => e.key === "Enter" && handleImport()}
        />
        <button
          onClick={handleImport}
          disabled={loading || !username.trim()}
          className="px-5 py-2.5 bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white font-semibold rounded-xl transition-all disabled:opacity-50 flex items-center justify-center gap-2 shrink-0 shadow-md shadow-cyan-600/20"
        >
          {loading ? (
            <>
              <Loader2 className="w-4 h-4 animate-spin" /> Fetching...
            </>
          ) : (
            <>
              <DownloadCloud className="w-4 h-4" /> Import Repos
            </>
          )}
        </button>
      </div>

      {successCount !== null && (
        <div className="flex items-center gap-2 mt-3 text-xs text-emerald-400 font-medium">
          <CheckCircle2 className="w-4 h-4" /> Successfully imported {successCount} projects and languages into your portfolio!
        </div>
      )}

      {error && (
        <div className="flex items-center gap-2 mt-3 text-xs text-rose-400 font-medium">
          <AlertCircle className="w-4 h-4" /> {error}
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/portfolio/ReadinessScorecard.tsx">
"use client";

import React, { useMemo } from "react";
import { CheckCircle2, Circle, ShieldCheck, Sparkles, FileText, Download, Code } from "lucide-react";
import { PortfolioContent } from "@/types/content";

interface ReadinessScorecardProps {
  content: PortfolioContent;
  onOpenDeploy?: () => void;
  onDownloadHtml?: () => void;
  onDownloadZip?: () => void;
  onCopyReadme?: () => void;
}

export function ReadinessScorecard({
  content,
  onOpenDeploy,
  onDownloadHtml,
  onDownloadZip,
  onCopyReadme,
}: ReadinessScorecardProps) {
  const audit = useMemo(() => {
    let score = 0;
    const checks: { label: string; passed: boolean; tip: string }[] = [];

    // 1. Name
    if (content.name?.trim()) {
      score += 15;
      checks.push({ label: "Full Name added", passed: true, tip: "" });
    } else {
      checks.push({ label: "Add Full Name", passed: false, tip: "Add your personal or studio name" });
    }

    // 2. Role / Title
    if (content.headline?.trim()) {
      score += 15;
      checks.push({ label: "Professional Role defined", passed: true, tip: "" });
    } else {
      checks.push({ label: "Define your Role", passed: false, tip: "e.g. AI Engineer, UI/UX Designer" });
    }

    // 3. Bio
    if (content.bio?.trim() && content.bio.length >= 30) {
      score += 20;
      checks.push({ label: "Compelling Bio", passed: true, tip: "" });
    } else {
      checks.push({ label: "Write a detailed bio", passed: false, tip: "Use AI Bio Generator for instant copy" });
    }

    // 4. Skills
    const skillCount = content.skills?.length || 0;
    if (skillCount >= 3) {
      score += 20;
      checks.push({ label: "Core Skills listed (3+)", passed: true, tip: "" });
    } else {
      checks.push({ label: "Add 3+ skills or technologies", passed: false, tip: "Import from GitHub or add tags" });
    }

    // 5. Projects
    const projectCount = content.projects?.length || 0;
    if (projectCount >= 2) {
      score += 20;
      checks.push({ label: "Featured Projects (2+)", passed: true, tip: "" });
    } else {
      checks.push({ label: "Showcase at least 2 projects", passed: false, tip: "Add live demo or GitHub links" });
    }

    // 6. Contact / Links
    if (content.contact?.email || content.contact?.github || content.contact?.linkedin) {
      score += 10;
      checks.push({ label: "Contact & Social links present", passed: true, tip: "" });
    } else {
      checks.push({ label: "Add Contact or Social links", passed: false, tip: "Provide email, LinkedIn, or GitHub" });
    }

    return { score: Math.min(100, score), checks };
  }, [content]);

  return (
    <div className="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 mb-6 text-sm">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4 pb-4 border-b border-slate-800">
