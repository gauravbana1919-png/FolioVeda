<file path="src/app/globals.css">
@import "tailwindcss";

@theme inline {
  --color-studio-alabaster: #F8F9FA;
  --color-deep-slate: #1E293B;
  --color-industrial-crimson: #173f32;
  --color-industrial-crimson-hover: #13352a;
  --color-forest-green: #173f32;
  --color-cyber-mint: #10B981;
  --color-nyc-yellow: #ebd800;
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-primary: var(--primary);
  --color-secondary: var(--secondary);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-border: var(--border);
  --font-sans: var(--font-sans-main), -apple-system, BlinkMacSystemFont, "Plus Jakarta Sans", sans-serif;
  --font-serif: "Instrument Serif", "Newsreader", "Georgia", serif;
  --font-mono: var(--font-mono), monospace;
}

:root {
  --background: #f7f4eb;
  --foreground: #222e26;
  --primary: #173f32;
  --secondary: #eeeaf4;
  --muted: #faf8f1;
  --muted-foreground: #5a6b60;
  --border: rgba(23, 63, 50, 0.15);
  --nyc-cream: #f7f4eb;
  --nyc-green: #173f32;
  --nyc-ink: #222e26;
  --nyc-yellow: #ebd800;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: -0.015em;
}

/* Not Your College Editorial Typography */
.font-editorial {
  font-family: 'Instrument Serif', Georgia, serif;
}

.font-editorial-italic {
  font-family: 'Instrument Serif', Georgia, serif;
  font-style: italic;
}

/* Squarespace-style Editorial Typography Helpers */
.font-display-serif {
  font-family: var(--font-serif-display), "Newsreader", "Canela", "Georgia", serif;
}

.font-sans-clean {
  font-family: var(--font-sans-main), -apple-system, BlinkMacSystemFont, sans-serif;
}

.editorial-italic {
  font-family: var(--font-serif-display), "Newsreader", "Georgia", serif;
  font-style: italic;
  font-weight: 300;
}

/* Rich Animations & Glow Effects */
@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 15px rgba(153, 27, 27, 0.25), 0 0 30px rgba(153, 27, 27, 0.1);
  }
  50% {
    box-shadow: 0 0 25px rgba(153, 27, 27, 0.45), 0 0 50px rgba(153, 27, 27, 0.2);
  }
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes floatGentle {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-4px); }
}

@keyframes shimmerEffect {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(200%); }
}

.animate-pulse-glow {
  animation: pulseGlow 3s infinite ease-in-out;
}

.animate-gradient-shift {
  background-size: 200% 200%;
  animation: gradientShift 6s ease infinite;
}

.animate-float {
  animation: floatGentle 4s ease-in-out infinite;
}

.shimmer-button {
  position: relative;
  overflow: hidden;
}

.shimmer-button::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transform: skewX(-20deg);
  animation: shimmerEffect 4s infinite;
}

/* Thread Drop & Pendulum Physics */
@keyframes threadDrop {
  0% {
    transform: translateY(-260px) rotate(0deg);
    opacity: 0;
  }
  60% {
    transform: translateY(22px) rotate(-3.5deg);
    opacity: 1;
  }
  78% {
    transform: translateY(-10px) rotate(2deg);
  }
  90% {
    transform: translateY(4px) rotate(-1deg);
  }
  100% {
    transform: translateY(0px) rotate(0deg);
    opacity: 1;
  }
}

@keyframes pendulumSwaySlow {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(1.6deg);
  }
  75% {
    transform: rotate(-1.6deg);
  }
}

@keyframes pendulumSwayDelayed {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(-1.8deg);
  }
  75% {
    transform: rotate(1.8deg);
  }
}

.animate-thread-drop {
  animation: threadDrop 1.1s cubic-bezier(0.22, 1.25, 0.36, 1) forwards;
}

.animate-pendulum-slow {
  animation: pendulumSwaySlow 6.5s ease-in-out infinite;
  transform-origin: top center;
}

.animate-pendulum-delayed {
  animation: pendulumSwayDelayed 7.5s ease-in-out infinite 0.8s;
  transform-origin: top center;
}
</file>

