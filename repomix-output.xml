      <path
        d="M 22 24 C 22 18, 28 14, 34 14 H 38 V 86 H 34 C 28 86, 22 82, 22 76 Z"
        fill="#4285F4"
      />

      {/* 2. Top Horizontal Folio Wing: Coral Red */}
