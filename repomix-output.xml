import { NextRequest, NextResponse } from "next/server";
import { GoogleGenAI } from "@google/genai";

const KNOWLEDGE_BASE = [
  {
    keywords: ["deploy", "github pages", "host", "publish", "github token", "pat"],
    answer: "🚀 **How to deploy to GitHub Pages:**\n1. Click the **'Deploy to GitHub Pages'** button in the top navigation bar.\n2. Enter your GitHub Personal Access Token (PAT) with `repo` and `workflow` permissions.\n3. Enter your desired repository name (e.g., `my-portfolio`).\n4. Click **'Build & Deploy'**.\nFolioVeda automatically compiles your portfolio, commits `index.html`, and configures GitHub Pages live at `https://<username>.github.io/<repo>/`!"
  },
  {
    keywords: ["import", "github repos", "fetch repos", "auto populate", "github"],
    answer: "🔄 **How to Auto-Import from GitHub:**\n1. Open the Portfolio Editor or click **'Import from GitHub'**.\n2. Enter your GitHub username (e.g. `gauravbana1919-png`).\n3. FolioVeda automatically pulls your public repositories, stars, language tech badges, bio, and avatar!"
  },
  {
    keywords: ["export", "download", "zip", "html", "readme", "pdf"],
    answer: "📦 **FolioVeda supports 4 instant export formats:**\n• **Standalone HTML**: A single portable `.html` file with embedded styles you can double-click or drag onto Netlify/Vercel.\n• **Project ZIP**: Full source code ZIP archive.\n• **GitHub Profile README**: Auto-generates Markdown for your `username/username` repository.\n• **Printable PDF Resume**: Clean formatted resume sheet."
  },
  {
    keywords: ["templates", "archetypes", "styles", "design", "recommend"],
    answer: "🎨 **FolioVeda Archetypes & Templates:**\n• **Neo-Brutalist**: High-contrast borders, offset solid shadows, and 90s retro pop accents.\n• **Glassmorphic**: Frosted glass cards with translucent glow.\n• **Claymorphic**: 3D pastel puffy neumorphism with soft rounded cards.\n• **Craft Desk (Rolan Gomes style)**: Cutting mat grid, physical stamps, and craft stickers.\n• **Wall Showcase (Sudarvel style)**: Telemetry badges, index counters, and metric drawers.\n• **Editorial Studio (Himanshu Singh style)**: Editorial typography with narrative storytelling.\n• **Luxe Creative (Loveleen Pereira style)**: Luxury minimalism, architectural white space, and brand world case studies.\n• **Terminal**: CRT hacker console with green monospaced typography."
  },
  {
    keywords: ["linkedin", "resume", "pdf upload", "parse"],
    answer: "📄 **LinkedIn & Resume PDF Parser:**\nOn LinkedIn, go to your profile, click **More (...) → Save to PDF**, and drop that file into FolioVeda. Our engine automatically parses your real experience, companies, credentials, and achievements!"
  }
];

export async function POST(req: NextRequest) {
  try {
    const { query, portfolioContext } = await req.json();

    if (!query || typeof query !== "string") {
      return NextResponse.json({ error: "Query is required." }, { status: 400 });
    }

    const lowerQuery = query.toLowerCase().trim();

    // 1. Check local knowledge base first for instant answer
    for (const item of KNOWLEDGE_BASE) {
      if (item.keywords.some((k) => lowerQuery.includes(k))) {
        return NextResponse.json({
          reply: item.answer,
          source: "knowledge_base",
        });
      }
    }

    // 2. Greetings
    if (lowerQuery.match(/\b(hi|hello|hey|hola|kem cho|namaste)\b/)) {
      return NextResponse.json({
        reply: "👋 **Hello! I'm PortBot**, your FolioVeda AI assistant.\n\nAsk me anything about creating portfolios, choosing templates, 1-click GitHub Pages deployment, or uploading your LinkedIn PDF!",
        source: "greeting",
      });
    }

    // 3. Fallback to Gemini if GEMINI_API_KEY is configured
    const apiKey = process.env.GEMINI_API_KEY;
    if (apiKey) {
      try {
        const ai = new GoogleGenAI({ apiKey });
        const systemPrompt = `You are PortBot, the smart, helpful AI assistant built into FolioVeda (a premium AI portfolio generator web app).
FolioVeda supports:
- Wall of Portfolios archetypes (Rolan Gomes craft desk, Sudarvel wall showcase, Himanshu Singh storytelling studio, Tanuja product design, Loveleen Pereira luxe creative).
- PortGen templates (Neo-Brutalist, Glass, Claymorphic, Terminal, Minimal, Modern).
- 1-Click GitHub Pages deployment (using user's GitHub Personal Access Token).
- 1-Click GitHub repository auto-import.
- Standalone HTML, ZIP, and GitHub Profile README exports.
- LinkedIn PDF / Resume PDF automatic parsing.

Answer concisely, friendly, and in clean GitHub-flavored markdown. Keep answers under 3-4 paragraphs.`;

        const response = await ai.models.generateContent({
          model: "gemini-2.5-flash",
          contents: [
            {
              role: "user",
              parts: [
                {
                  text: `${systemPrompt}\n\nUser Question: ${query}\nPortfolio Context: ${JSON.stringify(
                    portfolioContext || {}
                  )}`,
                },
              ],
            },
          ],
        });

        const text = response.text?.trim();
        if (text) {
          return NextResponse.json({ reply: text, source: "gemini" });
        }
      } catch (err: any) {
        console.warn("Gemini API call failed, falling back to guide response:", err.message);
      }
    }

    // 4. Default helpful fallback response
    return NextResponse.json({
      reply: `I can help you craft a standout portfolio! You can ask me about:\n• 🚀 **Deploying to GitHub Pages** in 1 click\n• 🎨 **Choosing the best template** (Neo-Brutalist, Glass, Craft Desk, Wall Showcase, Luxe)\n• 🔄 **Auto-importing your GitHub repositories**\n• 📄 **Parsing your LinkedIn or Resume PDF**\n• 📦 **Exporting as HTML, ZIP, or GitHub Profile README**\n\nWhat would you like to build?`,
      source: "fallback",
    });
  } catch (err: any) {
    return NextResponse.json(
      { error: err.message || "Failed to process message." },
      { status: 500 }
    );
  }
}
