        );
      }
      // Section Header (## )
      else if (trimmed.startsWith("## ")) {
        elements.push(
          <div key={`h2-${index}`} className="mt-4 mb-2 pb-1 border-b border-slate-900">
            <h2 className="text-xs font-bold uppercase tracking-wider text-slate-900">
              {trimmed.slice(3)}
            </h2>
