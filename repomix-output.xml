              {phase === 3 && "4. Structured Architectural Apple Tree Grows with Deep Roots"}
              {phase === 4 && "5. Golden Apple Drops → Live Portfolio Pops Up!"}
            </span>
          </div>

          <div className="flex items-center gap-1.5">
            {[0, 1, 2, 3, 4].map((s) => (
