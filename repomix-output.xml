      <span className="text-[#2EA043] font-bold">user@portfolio</span>
      <span className="text-[#8B949E]">:</span>
      <span className="text-[#79C0FF]">{path}</span>
      <span className="text-[#E6EDF3]">$ </span>
    </span>
