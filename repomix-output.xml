        );
      }
      // Subsection / Role entry (### )
      else if (trimmed.startsWith("### ")) {
        const rawTitle = trimmed.slice(4);
        // Parse Title — Company | Dates | Location
        const parts = rawTitle.split("|").map((p) => p.trim());
        const leftSide = parts[0] || "";
        const dates = parts[1] || "";
