"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import { 
  ArrowLeft, 
  Sparkles, 
  ShieldCheck, 
  Sliders, 
  CheckCircle2, 
  ExternalLink, 
  Lock, 
  Globe, 
  Layers, 
  Check, 
  Eye, 
  RefreshCw,
  Info,
  ArrowRight
} from "lucide-react";
import { FolioVedaLogo } from "@/components/ui/Logo";
import { StyleProfile, ClosenessLevel } from "@/types/inspiration";
import { ThemePackage } from "@/types/theme";
import { ThemeRenderer } from "@/components/portfolio/engine/ThemeRenderer";
import { mapUserToPortfolioContent } from "@/lib/themes/registry";

export default function InspirationPage() {
  const [userData, setUserData] = useState<any>(null);
  const [inputUrl, setInputUrl] = useState("https://pattin.design");
  const [userConsent, setUserConsent] = useState(false);
  const [isAnalyzing, setIsAnalyzing] = useState(false);
  const [isGenerating, setIsGenerating] = useState(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);

  // Inspiration Analysis & Theme State
  const [requestId, setRequestId] = useState<string | null>(null);
  const [extractedProfile, setExtractedProfile] = useState<StyleProfile | null>(null);
  const [analysisNotice, setAnalysisNotice] = useState<string | null>(null);
  const [closeness, setCloseness] = useState<ClosenessLevel>("medium");
  const [generatedTheme, setGeneratedTheme] = useState<ThemePackage | null>(null);

  // Application feedback toast
  const [appliedToast, setAppliedToast] = useState<{ name: string; url: string } | null>(null);
  const [isApplying, setIsApplying] = useState(false);

  // Load user data on mount
  useEffect(() => {
    async function loadUser() {
      try {
        const res = await fetch("/api/portfolio");
        if (res.ok) {
          const data = await res.json();
          if (data.user) setUserData(data.user);
        }
      } catch (err) {
        console.warn("Could not load user in inspiration studio:", err);
      }
    }
    loadUser();
  }, []);

  const normalizedContent = mapUserToPortfolioContent(userData);

  // 1. Analyze External URL
  const handleAnalyze = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!userConsent) {
      setErrorMsg("Please accept the originality confirmation checkbox.");
      return;
    }

    setErrorMsg(null);
    setIsAnalyzing(true);
    setGeneratedTheme(null);
    setExtractedProfile(null);
    setAnalysisNotice(null);

    try {
      const res = await fetch("/api/inspiration/analyze", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url: inputUrl, userConsent: true }),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || "Analysis failed.");
      }

      setRequestId(data.requestId);
      setExtractedProfile(data.styleProfile);
      if (data.notice) setAnalysisNotice(data.notice);

      // Automatically synthesize medium closeness theme
      await handleGenerateTheme(data.requestId, "medium");
    } catch (err: any) {
      setErrorMsg(err.message || "Failed to analyze URL.");
    } finally {
      setIsAnalyzing(false);
    }
  };

  // 2. Generate Theme with Closeness
  const handleGenerateTheme = async (reqId: string, level: ClosenessLevel) => {
    setIsGenerating(true);
    try {
      const res = await fetch("/api/inspiration/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          requestId: reqId,
          closeness: level,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || "Failed to generate theme.");
      }

      setGeneratedTheme(data.theme);
      setCloseness(level);
    } catch (err: any) {
      setErrorMsg(err.message || "Theme generation failed.");
    } finally {
      setIsGenerating(false);
    }
  };

  // 3. Apply Generated Theme to Live Portfolio
  const handleApplyTheme = async () => {
    if (!generatedTheme) return;
    setIsApplying(true);
    try {
      // Map layout pattern to genuine system archetype package
      let targetTemplateId = "sudarvel";
      const pat = generatedTheme.layout.pattern;
      if (pat === "craft-desk") targetTemplateId = "rolan-gomes";
      else if (pat === "wall-showcase") targetTemplateId = "sudarvel";
      else if (pat === "himanshu-studio") targetTemplateId = "himanshu-singh";
      else if (pat === "tanuja-product") targetTemplateId = "tanuja-design";
      else if (pat === "luxe-creative") targetTemplateId = "luxe-creative";
      else if (pat === "not-your-college") targetTemplateId = "not-your-college";
      else if (pat === "neo-brutalist") targetTemplateId = "neo-brutalist";
      else if (pat === "glass") targetTemplateId = "glass";
      else if (pat === "claymorphic") targetTemplateId = "claymorphic";
      else if (pat === "terminal-grid") targetTemplateId = "developer-terminal";
      else if (pat === "centered-editorial") targetTemplateId = "minimal-editorial";
      else if (pat === "split-hero") targetTemplateId = "corporate-clean";
      else if (pat === "dark-showcase") targetTemplateId = "dark-showcase";
      else if (pat === "playful-sticker") targetTemplateId = "playful-sticker";
      else if (pat === "poster") targetTemplateId = "bold-poster";

      const res = await fetch("/api/portfolio", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          templateId: targetTemplateId,
          themeId: targetTemplateId,
          theme: generatedTheme.tokens.colors.bg.toLowerCase().includes("#0") || generatedTheme.tokens.colors.bg.toLowerCase().includes("#1") ? "dark" : "light",
